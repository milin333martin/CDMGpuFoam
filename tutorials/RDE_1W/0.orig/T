FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298;

boundaryField
{
    inlet
    {
        type            rdeInletTemperature;
#include "$FOAM_CASE/constant/rdeInjector"
        value           uniform 298;
    }

    outlet
    {
        // Supersonic or near-sonic exhaust, so extrapolation is adequate.
        // If the exhaust goes subsonic and reflections contaminate the
        // chamber, swap in waveTransmissive (see docs/10-rde.md).
        type            zeroGradient;
    }

    left
    {
        type            cyclic;
    }

    right
    {
        type            cyclic;
    }

    frontAndBack
    {
        type            empty;
    }

    internalFaces
    {
        type            internal;
    }
}

// ************************************************************************* //
