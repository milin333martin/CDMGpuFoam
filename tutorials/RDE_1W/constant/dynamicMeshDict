FoamFile
{
    format          ascii;
    class           dictionary;
    location        "constant";
    object          dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    type            refiner2D;
    libs            ( "libCDMDynamicMesh2D.so" );
    refineInterval  8;
    field           refinementIndicator;
    lowerRefineLevel 0.05;
    upperRefineLevel 1e+06;
    unrefineLevel   0.015;
    nBufferLayers   2;
    maxRefinement   3;
    maxCells        6000000;
    correctFluxes   ( ( phi none ) );
    dumpLevel       true;
}


